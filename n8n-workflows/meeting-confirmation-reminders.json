    {
      "parameters": {
        "fromEmail": "Mithun Das <mithun@mithundas.cloud>",
        "toEmail": "={{ $('Calculate Reminder Schedules').first().json.email }}, mithun.here01@gmail.com",
        "subject": "={{ '⏰ Starting in 10 Mins: Discovery Session for ' + $('Calculate Reminder Schedules').first().json.company }}",
        "html": "={{ `<div style=\"font-family: Arial, sans-serif; max-width: 580px; margin: 0 auto; padding: 24px;\"><h2>⏰ Starting in 10 Minutes!</h2><p>Hi ${$('Calculate Reminder Schedules').first().json.name}, your discovery session starts in 10 minutes.</p><p><a href=\"${$('Calculate Reminder Schedules').first().json.meetUrl}\" style=\"background: #0ea5e9; color: #fff; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold;\">🚀 Click Here to Join Meeting Room</a></p></div>` }}"
      },
