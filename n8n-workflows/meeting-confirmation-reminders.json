r Schedules').first().json.scheduledDate} @ ${$('Calculate Reminder Schedules').first().json.scheduledTime} (${$('Calculate Reminder Schedules').first().json.timeZone || 'IST'})</div>\n      <div><b>🎥 Video Room Link:</b> <a href=\"${$('Calculate Reminder Schedules').first().json.meetUrl}\" style=\"color: #0ea5e9; font-weight: bold;\">${$('Calculate Reminder Schedules').first().json.meetUrl}</a></div>\n    </div>\n  </div>\n\n  <div style=\"padding: 0 32px 28px 32px; text-align: center;\">\n    <a href=\"${$('Calculate Reminder Schedules').first().json.meetUrl}\" style=\"display: inline-block; background: linear-gradient(135deg, #0ea5e9, #6366f1); color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 8px; font-family: Arial, sans-serif; font-size: 15px; font-weight: 700; letter-spacing: 0.5px; box-shadow: 0 4px 12px rgba(14, 165, 233, 0.25);\">🚀 Click Here to Join Meeting Room</a>\n  </div>\n  \n  <div style=\"padding: 0 32px;\"><div style=\"border-top: 1px solid #f1f5f9;\"></div></div>\n  \n  <div style=\"padding: 24px 32px 28px 32px;\">\n    <table cellpadding=\"0\" cellspacing=\"0\" style=\"border: none;\">\n      <tr>\n        <td style=\"padding-right: 16px; border-right: 2px solid #0ea5e9; vertical-align: middle;\">\n          <img src=\"https://mithundas.cloud/logo.png\" alt=\"M\" style=\"width: 42px; height: 42px; border-radius: 8px; display: block;\">\n        </td>\n        <td style=\"padding-left: 16px; vertical-align: middle;\">\n          <span style=\"font-family: Arial, sans-serif; font-size: 15px; font-weight: 700; color: #0f172a;\">Mithun Das</span><br>\n          <span style=\"font-family: Arial, sans-serif; font-size: 11px; color: #64748b; text-transform: uppercase; font-weight: 600; letter-spacing: 1px;\">Founder & Automation Architect</span><br>\n          <a href=\"https://mithundas.cloud\" style=\"font-family: Arial, sans-serif; font-size: 12px; color: #0ea5e9; text-decoration: none; font-weight: 600;\">Mithun Das AI Automation</a>\n        </td>\n      </tr>\n    </table>\n  </div>\n  <div style=\"height: 3px; background: linear-gradient(90deg, #0ea5e9, #6366f1, #0ea5e9);\"></div>\n</div>` }}",
