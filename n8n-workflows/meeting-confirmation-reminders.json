        "toEmail": "={{ $('Calculate Reminder Schedules').first().json.email }}, mithun.here01@gmail.com",
        "subject": "={{ '⌛ 1 Hour Until Your Discovery Session — ' + $('Calculate Reminder Schedules').first().json.company }}",
        "html": "={{ `<div style=\"font-family: Arial, sans-serif; max-width: 580px; margin: 0 auto; padding: 24px;\"><h2>⌛ 1 Hour Until Your Discovery Session</h2><p>Hi ${$('Calculate Reminder Schedules').first().json.name}, just a friendly reminder that your discovery call is in 1 hour.</p><p><a href=\"${$('Calculate Reminder Schedules').first().json.meetUrl}\">${$('Calculate Reminder Schedules').first().json.meetUrl}</a></p><p><a href=\"https://mithundas.cloud/book/reschedule?bookingId=${$('Calculate Reminder Schedules').first().json.bookingId}\">🔄 Need to Reschedule? Click Here</a></p></div>` }}"
      },
      "id": "send-1hour-reminder-branch2",
      "name": "Send 1-Hour Reminder Email",
      "type": "n8n-nodes-base.emailSend",
