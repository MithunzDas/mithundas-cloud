{
  "name": "Mithun Das — Meeting Confirmation & Automated Reminder Engine",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meeting-booked",
        "options": {}
      },
      "id": "webhook-meeting-booked",
      "name": "Meeting Booked Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "meeting-rescheduled",
        "options": {}
      },
      "id": "webhook-meeting-rescheduled",
      "name": "Meeting Rescheduled Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot<YOUR_MEETING_BOT_TOKEN>/sendMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  \"chat_id\": \"<YOUR_MEETING_TELEGRAM_CHAT_ID>\",\n  \"text\": ($json.body.event === 'meeting_rescheduled' ? '🔄 MEETING RESCHEDULED!\\n\\n' : '🎉 NEW DISCOVERY CALL BOOKED!\\n\\n') +\n    \"👤 Client: \" + ($json.body.name || '') +\n    \"\\n🏢 Company: \" + ($json.body.company || '') +\n    \"\\n💼 Industry: \" + ($json.body.businessType || 'General') +\n    \"\\n✉️ Email: \" + ($json.body.email || '') +\n    \"\\n📅 Scheduled Date: \" + ($json.body.date || $json.body.newDate || '') + \" @ \" + ($json.body.time || $json.body.newTime || '') + \" (\" + ($json.body.timeZone || $json.body.newTimeZone || 'IST') + \")\" +\n    \"\\n🆔 Reference: \" + ($json.body.bookingId || '') +\n    \"\\n\\n🎥 Video Room Link:\\n\" + ($json.body.meetUrl || '') +\n    \"\\n\\n📋 SOW / Requirements:\\n\" + ($json.body.projectRequirement || 'None')\n}) }}"
      },
      "id": "telegram-meeting-alert",
      "name": "Telegram: Meeting Alert Bot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        350,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "Mithun Das <mithun@mithundas.cloud>",
        "toEmail": "={{$('Meeting Booked Webhook').first()?.json?.body?.email || $('Meeting Rescheduled Webhook').first()?.json?.body?.email}}",
        "subject": "={{ ($json.body.event === 'meeting_rescheduled' ? '🔄 Session Rescheduled — ' : 'Discovery Session Confirmed — ') + ($json.body.company || '') + ' | Mithun Das' }}",
        "html": "={{ `<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; background: #ffffff; color: #1e293b; border-radius: 12px; overflow: hidden; border: 1px solid #e2e8f0;\"><div style=\"height: 4px; background: linear-gradient(90deg, #0ea5e9, #6366f1, #0ea5e9);\"></div><div style=\"padding: 24px 32px; border-bottom: 1px solid #f1f5f9;\"><table cellpadding=\"0\" cellspacing=\"0\" style=\"border: none;\"><tr><td style=\"padding-right: 12px;\"><img src=\"https://mithundas.cloud/logo.png\" alt=\"M\" style=\"width: 38px; height: 38px; border-radius: 8px;\"></td><td><span style=\"font-size: 16px; font-weight: 800; color: #0f172a;\">Mithun Das</span><br><span style=\"font-size: 10px; color: #0ea5e9; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px;\">AI AUTOMATION</span></td></tr></table></div><div style=\"padding: 28px 32px;\"><h2 style=\"font-size: 20px; color: #0f172a; margin-top: 0;\">${$json.body.event === 'meeting_rescheduled' ? 'Your Session Has Been Rescheduled! 🔄' : 'Your Discovery Session is Confirmed! 🎉'}</h2><p style=\"font-size: 15px; color: #334155; line-height: 1.6;\">Hi <b>${$json.body.name}</b>,</p><p style=\"font-size: 15px; color: #334155; line-height: 1.6;\">Your 15-minute AI Architecture Discovery Session for <b>${$json.body.company}</b> has been updated. Below are your new session details:</p><div style=\"background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 18px; margin: 20px 0; font-family: monospace; font-size: 13px;\"><p style=\"margin: 4px 0;\"><b>📅 New Date & Time:</b> ${$json.body.date || $json.body.newDate} @ ${$json.body.time || $json.body.newTime} (${$json.body.timeZone || $json.body.newTimeZone || 'IST'})</p><p style=\"margin: 4px 0;\"><b>🆔 Reference:</b> ${$json.body.bookingId}</p><p style=\"margin: 4px 0;\"><b>🎥 Video Room:</b> <a href=\"${$json.body.meetUrl}\" style=\"color: #0ea5e9; font-weight: bold;\">${$json.body.meetUrl}</a></p></div></div><div style=\"padding: 0 32px 28px 32px; text-align: center;\"><a href=\"${$json.body.meetUrl}\" style=\"display: inline-block; background: linear-gradient(135deg, #0ea5e9, #6366f1); color: #ffffff; text-decoration: none; padding: 14px 30px; border-radius: 8px; font-family: Arial, sans-serif; font-size: 14px; font-weight: 700; letter-spacing: 0.5px;\">🚀 Join Video Meeting Room Now</a><div style=\"margin-top: 14px;\"><a href=\"https://mithundas.cloud/book/reschedule?bookingId=${$json.body.bookingId}\" style=\"color: #64748b; font-size: 12px; font-family: Arial, sans-serif; text-decoration: underline;\">🔄 Need to Reschedule Your Session? Click Here</a></div></div><div style=\"height: 3px; background: linear-gradient(90deg, #0ea5e9, #6366f1, #0ea5e9);\"></div></div>` }}"
      },
      "id": "email-client-confirmation",
      "name": "Email: Client Confirmation",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        550,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "Mithun Das AI Automation <mithun@mithundas.cloud>",
        "toEmail": "mithun.here01@gmail.com",
        "subject": "={{ ($json.body.event === 'meeting_rescheduled' ? '🔄 MEETING RESCHEDULED: ' : '📅 NEW MEETING: ') + ($json.body.company || '') + ' (' + ($json.body.name || '') + ')' }}",
        "html": "={{ `<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; background: #ffffff; color: #1e293b; padding: 24px;\"><h2 style=\"color: #0ea5e9;\">${$json.body.event === 'meeting_rescheduled' ? '🔄 Meeting Rescheduled!' : '🎉 New Meeting Booked!'}</h2><p><b>Client Name:</b> ${$json.body.name}</p><p><b>Company:</b> ${$json.body.company} (${$json.body.businessType})</p><p><b>Email:</b> ${$json.body.email}</p><p><b>New Scheduled Time:</b> ${$json.body.date || $json.body.newDate} @ ${$json.body.time || $json.body.newTime} (${$json.body.timeZone || $json.body.newTimeZone || 'IST'})</p><p><b>Video Room Link:</b> <a href=\"${$json.body.meetUrl}\">${$json.body.meetUrl}</a></p></div>` }}"
      },
      "id": "email-host-notification",
      "name": "Email: Host Notification (mithun.here01@gmail.com)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        750,
        300
      ]
    },
    {
      "parameters": {
        "calendar": "primary",
        "summary": "={{ 'Discovery Session — ' + ($json.body.company || '') + ' (' + ($json.body.name || '') + ')' }}",
        "description": "={{ 'AI Discovery Session for ' + ($json.body.company || '') + '\\n\\nVideo Room: ' + $json.body.meetUrl }}",
        "start": "={{ $json.body.meetingStartISO }}",
        "end": "={{ new Date(new Date($json.body.meetingStartISO).getTime() + 15 * 60 * 1000).toISOString() }}",
        "attendees": [
          "={{ $json.body.email }}"
        ],
        "options": {
          "sendUpdates": "all"
        }
      },
      "id": "google-calendar-create",
      "name": "Google Calendar: Create Event & Invite",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [
        950,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst item = input.body || input;\nconst bookedAt = new Date(item.bookedAt || new Date()).getTime();\nconst meetingStart = new Date(item.meetingStartISO || new Date()).getTime();\nconst hoursDiff = (meetingStart - bookedAt) / (1000 * 60 * 60);\n\nreturn [{\n  json: {\n    ...item,\n    scheduledDate: item.date || item.newDate,\n    scheduledTime: item.time || item.newTime,\n    hoursDiff,\n    isWithin24Hours: hoursDiff <= 24,\n    reminder1HourISO: new Date(meetingStart - 60 * 60 * 1000).toISOString(),\n    reminder10MinISO: new Date(meetingStart - 10 * 60 * 1000).toISOString()\n  }\n}];"
      },
      "id": "calculate-reminders",
      "name": "Calculate Reminder Schedules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isWithin24Hours }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-scheduled-within-24h",
      "name": "Is Scheduled Within 24 Hours?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1350,
        300
      ]
    },
    {
      "parameters": {
        "amount": "={{ Math.max(0, (new Date($json.reminder10MinISO).getTime() - Date.now()) / 1000) }}",
        "unit": "seconds"
      },
      "id": "wait-10min-branch1",
      "name": "Wait Until 10-Min Before Call",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [
        1550,
        200
      ]
    },
    {
