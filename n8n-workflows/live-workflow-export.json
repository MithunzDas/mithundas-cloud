        "jsCode": "const booking = $('Prepare Booking Data').first().json;\nconst bookedAt = new Date(booking.bookedAt || new Date()).getTime();\nconst meetingStart = new Date(booking.meetingStartISO || new Date()).getTime();\nconst hoursDiff = (meetingStart - bookedAt) / (1000 * 60 * 60);\n\nreturn [{\n  json: {\n    ...booking,\n    scheduledDate: booking.date,\n    scheduledTime: booking.time,\n    hoursDiff,\n    isWithin24Hours: hoursDiff <= 24,\n    reminder1HourISO: new Date(meetingStart - 60 * 60 * 1000).toISOString(),\n    reminder10MinISO: new Date(meetingStart - 10 * 60 * 1000).toISOString()\n  }\n}];"
