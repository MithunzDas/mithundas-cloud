// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id                 String   @id @default(cuid())
  leadId             String   @unique
  name               String
  email              String
  company            String
  businessType       String
  budget             String
  timeline           String
  projectRequirement String
  whatsapp           String?
  country            String?
  status             String   @default("intake") // "intake", "contacted", "qualified", "silent", "won", "lost"
  aiScore            Int?
  aiSummary          String?
  submittedAt        DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

model EmailLog {
  id          String   @id @default(cuid())
  leadId      String?
  toEmail     String
  fromEmail   String
  subject     String
  category    String   // "onboarding", "confirmation", "followup", "admin_alert"
  htmlContent String?  @db.Text
  status      String   @default("sent") // "sent", "failed"
  sentAt      DateTime @default(now())

  @@index([toEmail])
  @@index([leadId])
}

model Booking {
  id                 String   @id @default(cuid())
  bookingId          String   @unique
  name               String
  email              String
  company            String
  businessType       String   @default("General")
  projectRequirement String   @db.Text
  date               String   // YYYY-MM-DD
  time               String   // HH:MM AM/PM
  timeZone           String   @default("Asia/Kolkata")
  meetUrl            String
  status             String   @default("confirmed") // "confirmed", "cancelled"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([date, time])
  @@index([email])
}

model Invoice {
  id                   String               @id @default(cuid())
  invoiceId            String               @unique
  leadId               String?
  clientName           String
  clientEmail          String
  companyName          String
  currency             String               @default("USD")
  currencySymbol       String               @default("$")
  totalAmount          String
  totalAmountNumeric   Float                @default(0)
  depositPercent       String               @default("50")
  depositAmount        String
  receivedAmountNumeric Float               @default(0)
  remainingAmountNumeric Float              @default(0)
  setupFee             String?
  monthlyRetainer      String?
  projectScope         String               @db.Text
  paymentStatus        String               @default("unpaid") // "unpaid", "partially_paid", "paid_in_full"
  paymentLink          String?              @db.Text
  customPaymentMethods String?              @db.Text // JSON string of custom payment methods
  issueDate            String
  dueDate              String
  paidAt               DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  transactions         PaymentTransaction[]

  @@index([invoiceId])
  @@index([clientEmail])
}

model PaymentTransaction {
  id                 String    @id @default(cuid())
  transactionId      String    @unique
  invoiceId          String
  invoice            Invoice   @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  clientName         String
  clientEmail        String
  companyName        String?
  amount             Float
  currency           String    @default("USD")
  currencySymbol     String    @default("$")
  paymentMethod      String    // "stripe", "razorpay", "upi", "cash", "paypal", "wise", "wire"
  utrOrReference     String?   // UTR number, Cash Receipt #, or Gateway Txn ID
  verificationStatus String    @default("pending") // "pending", "verified", "rejected"
  notes              String?   @db.Text
  verifiedBy         String?
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([invoiceId])
  @@index([verificationStatus])
}

// ===== Affidavit Generator SaaS Models =====

model AffidavitUser {
  id                        String              @id @default(cuid())
  email                     String?             @unique
  phone                     String?             @unique
  name                      String?
  avatarUrl                 String?
  googleId                  String?             @unique
  creditBalance             Int                 @default(0)
  isFirstPurchaseDone       Boolean             @default(false)
  defaultAdvocateName       String?
  defaultAdvocateEnrollment String?
  defaultCourtHeader        String?
  otpCode                   String?
  otpExpiresAt              DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  purchases                 AffidavitPurchase[]
  downloads                 AffidavitDownload[]

  @@index([email])
  @@index([phone])
  @@index([googleId])
}

model AffidavitPurchase {
  id                String        @id @default(cuid())
  userId            String
  user              AffidavitUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  planName          String        // "starter", "basic", "pro", "bulk"
  amount            Float
  creditsAdded      Int
  razorpayOrderId   String?
  razorpayPaymentId String?
  status            String        @default("pending") // "pending", "completed", "failed"
  createdAt         DateTime      @default(now())

  @@index([userId])
  @@index([razorpayOrderId])
}

model AffidavitDownload {
  id              String        @id @default(cuid())
  userId          String
  user            AffidavitUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  affidavitType   String        // "caa", "rent", "general", etc.
  pageCount       Int
  creditsDeducted Int
  formData        String?       @db.Text // JSON of the form data used
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([affidavitType])
}


// ===== Lead Generation & Prospecting Engine Models =====

model ScrapedLeadBatch {
  id          String        @id @default(cuid())
  batchId     String        @unique
  category    String
  city        String
  searchQuery String
  targetCount Int           @default(50)
  totalFound  Int           @default(0)
  hotCount    Int           @default(0)
  createdAt   DateTime      @default(now())
  leads       ScrapedLead[]

  @@index([category, city])
  @@index([createdAt])
}

model ScrapedLead {
  id               String            @id @default(cuid())
  leadId           String            @unique
  batchId          String?
  batch            ScrapedLeadBatch? @relation(fields: [batchId], references: [batchId], onDelete: SetNull)
  placeId          String?
  businessName     String
  category         String
  searchQuery      String?
  city             String?
  fullAddress      String?           @db.Text
  phone            String?
  whatsappNumber   String?
  whatsappUrl      String?           @db.Text
  email            String?
  secondaryEmails  String?
  website          String?           @db.Text
  hasWebsite       Boolean           @default(false)
  cmsTech          String?
  instagramUrl     String?
  facebookUrl      String?
  linkedinUrl      String?
  twitterUrl       String?
  youtubeUrl       String?
  rating           Float?            @default(0)
  reviewCount      Int?              @default(0)
  isOpen           Boolean           @default(true)
  businessHours    String?
  leadScore        Int?              @default(0)
  leadTier         String?
  recommendedPitch String?           @db.Text
  gmapsUrl         String?           @db.Text
  outreachStatus   String            @default("NEW") // "NEW", "SENT", "REPLIED", "CONVERTED", "REJECTED"
  lastReplyMessage String?           @db.Text
  contactedAt      DateTime?
  repliedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  messages         LeadChatMessage[]

  @@index([outreachStatus])
  @@index([leadTier])
  @@index([city, category])
  @@index([phone])
}

model LeadChatMessage {
  id          String       @id @default(cuid())
  leadId      String
  lead        ScrapedLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sender      String       // "CLIENT" | "ADMIN"
  direction   String       // "INBOUND" | "OUTBOUND"
  channel     String       @default("WHATSAPP") // "WHATSAPP", "MANUAL"
  messageText String       @db.Text
  wamid       String?
  status      String?      @default("SENT") // "SENT", "DELIVERED", "READ", "FAILED"
  rawPayload  String?      @db.Text
  createdAt   DateTime     @default(now())

  @@index([leadId])
  @@index([wamid])
  @@index([createdAt])
}

// ===== QR-Based AI Google Review SaaS Models =====

model ReviewBusiness {
  id                 String            @id @default(cuid())
  slug               String            @unique
  businessName       String
  ownerName          String?
  ownerEmail         String
  ownerPhone         String?
  category           String            @default("DENTIST") // "DENTIST", "GYM", "SALON_SPA", "RESTAURANT_CAFE", "AUTO_REPAIR", "CLINIC_HEALTHCARE", "GENERAL_SERVICES"
  city               String?
  country            String?           @default("US")
  placeId            String?
  googleReviewUrl    String            @db.Text
  logoUrl            String?
  primaryColor       String?           @default("#2563eb")
  trialStatus        String            @default("TRIAL_ACTIVE") // "TRIAL_ACTIVE", "SUBSCRIBED", "EXPIRED", "CANCELLED"
  trialEndsAt        DateTime
  subscriptionPlan   String?           // "MONTHLY_30", "ANNUAL_249"
  subscriptionMethod String?           // "PAYPAL", "LEMON_SQUEEZY", "STRIPE", "RAZORPAY"
  subscriptionId     String?
  customQuestions    String?           @db.Text // JSON override of question bank
  activationToken    String?           @unique
  totalScans         Int               @default(0)
  totalReviewsCopied Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  sessions           ReviewSession[]
  privateFeedbacks   PrivateFeedback[]

  @@index([slug])
  @@index([ownerEmail])
  @@index([trialStatus])
}

model ReviewSession {
  id                 String         @id @default(cuid())
  businessId         String
  business           ReviewBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  selectedQuestions  String         @db.Text // JSON: array of { question: string, answer: string }
  generatedReview    String?        @db.Text
  ratingScore        Int?           @default(5)
  sentiment          String?        @default("POSITIVE") // "POSITIVE", "NEUTRAL", "NEGATIVE"
  copiedToClipboard  Boolean        @default(false)
  redirectedToGoogle Boolean        @default(false)
  deviceType         String?        @default("mobile") // "mobile", "desktop", "tablet"
  userAgent          String?        @db.Text
  createdAt          DateTime       @default(now())

  @@index([businessId])
  @@index([createdAt])
}

model PrivateFeedback {
  id            String         @id @default(cuid())
  businessId    String
  business      ReviewBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerName  String?
  customerPhone String?
  customerEmail String?
  feedbackText  String         @db.Text
  ratingScore   Int            @default(2)
  resolved      Boolean        @default(false)
  createdAt     DateTime       @default(now())

  @@index([businessId])
  @@index([resolved])
}
