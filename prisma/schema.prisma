// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id                 String   @id @default(cuid())
  leadId             String   @unique
  name               String
  email              String
  company            String
  businessType       String
  budget             String
  timeline           String
  projectRequirement String
  whatsapp           String?
  country            String?
  status             String   @default("intake") // "intake", "contacted", "qualified", "silent", "won", "lost"
  aiScore            Int?
  aiSummary          String?
  submittedAt        DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

model EmailLog {
  id          String   @id @default(cuid())
  leadId      String?
  toEmail     String
  fromEmail   String
  subject     String
  category    String   // "onboarding", "confirmation", "followup", "admin_alert"
  htmlContent String?  @db.Text
  status      String   @default("sent") // "sent", "failed"
  sentAt      DateTime @default(now())

  @@index([toEmail])
  @@index([leadId])
}

model Booking {
  id                 String   @id @default(cuid())
  bookingId          String   @unique
  name               String
  email              String
  company            String
  businessType       String   @default("General")
  projectRequirement String   @db.Text
  date               String   // YYYY-MM-DD
  time               String   // HH:MM AM/PM
  timeZone           String   @default("Asia/Kolkata")
  meetUrl            String
  status             String   @default("confirmed") // "confirmed", "cancelled"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([date, time])
  @@index([email])
}

model Invoice {
  id                   String               @id @default(cuid())
  invoiceId            String               @unique
  leadId               String?
  clientName           String
  clientEmail          String
  companyName          String
  currency             String               @default("USD")
  currencySymbol       String               @default("$")
  totalAmount          String
  totalAmountNumeric   Float                @default(0)
  depositPercent       String               @default("50")
  depositAmount        String
  receivedAmountNumeric Float               @default(0)
  remainingAmountNumeric Float              @default(0)
  setupFee             String?
  monthlyRetainer      String?
  projectScope         String               @db.Text
  paymentStatus        String               @default("unpaid") // "unpaid", "partially_paid", "paid_in_full"
  paymentLink          String?              @db.Text
  customPaymentMethods String?              @db.Text // JSON string of custom payment methods
  issueDate            String
  dueDate              String
  paidAt               DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  transactions         PaymentTransaction[]

  @@index([invoiceId])
  @@index([clientEmail])
}

model PaymentTransaction {
  id                 String    @id @default(cuid())
  transactionId      String    @unique
  invoiceId          String
  invoice            Invoice   @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  clientName         String
  clientEmail        String
  companyName        String?
  amount             Float
  currency           String    @default("USD")
  currencySymbol     String    @default("$")
  paymentMethod      String    // "stripe", "razorpay", "upi", "cash", "paypal", "wise", "wire"
  utrOrReference     String?   // UTR number, Cash Receipt #, or Gateway Txn ID
  verificationStatus String    @default("pending") // "pending", "verified", "rejected"
  notes              String?   @db.Text
  verifiedBy         String?
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())

  @@index([invoiceId])
  @@index([verificationStatus])
}



